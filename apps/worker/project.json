{
  "name": "worker",
  "sourceRoot": "apps/worker/src",
  "tags": ["scope:worker", "platform:server"],
  "implicitDependencies": ["runtime"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b apps/worker/tsconfig.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/worker/tsconfig.json --noEmit"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch --conditions=development apps/worker/src/main.ts"
      }
    }
  }
}
