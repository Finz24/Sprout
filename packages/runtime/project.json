{
  "name": "runtime",
  "sourceRoot": "packages/runtime/src",
  "tags": ["scope:runtime", "platform:server"],
  "implicitDependencies": ["contracts", "database"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b packages/runtime/tsconfig.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/runtime/tsconfig.json --noEmit"
      }
    }
  }
}
