{
  "name": "contracts",
  "sourceRoot": "packages/contracts/src",
  "tags": ["scope:contracts", "platform:shared"],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b packages/contracts/tsconfig.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/contracts/tsconfig.json --noEmit"
      }
    }
  }
}
