{
  "name": "ui",
  "sourceRoot": "packages/ui/src",
  "tags": ["scope:ui", "platform:browser"],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b packages/ui/tsconfig.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/ui/tsconfig.json --noEmit"
      }
    }
  }
}
