{
  "name": "sprout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "nx run-many -t serve -p web api worker --parallel=3 --outputStyle=stream",
    "build": "nx run-many -t build --parallel=3",
    "typecheck": "nx run-many -t typecheck --parallel=3 && tsc -p tsconfig.tools.json",
    "lint": "eslint apps packages tests *.ts eslint.config.mjs --max-warnings=0",
    "doctor": "react-doctor --yes --verbose --no-supply-chain --no-telemetry",
    "doctor:changed": "react-doctor --yes --verbose --no-supply-chain --no-telemetry --scope changed",
    "format:check": "prettier --check apps packages tests *.json *.ts *.yaml eslint.config.mjs .github/workflows docs/development.md docs/adr/0004-effect-api-and-worker.md",
    "format:write": "prettier --write apps packages tests *.json *.ts *.yaml eslint.config.mjs .github/workflows docs/development.md docs/adr/0004-effect-api-and-worker.md",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "migrate": "tsx --conditions=development packages/database/src/migrate.ts",
    "owner:bootstrap": "tsx --conditions=development packages/runtime/src/bootstrap.ts",
    "db:generate": "drizzle-kit generate --config packages/database/drizzle.config.ts",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "check:affected": "nx affected -t typecheck,build --parallel=3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/devkit": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@playwright/test": "1.64.0",
    "@sprout/contracts": "workspace:*",
    "@sprout/database": "workspace:*",
    "@sprout/runtime": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "better-auth": "1.6.23",
    "drizzle-kit": "0.31.11",
    "effect": "4.0.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "nx": "23.3.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "react-doctor": "0.9.17",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
